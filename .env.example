# ============ 拾光成长 · 服务端环境变量模板 ============
# 复制本文件为 .env 并填入真实值。切勿把 .env 提交到 Git。

# ---------- 服务 ----------
PORT=8787
HOST=0.0.0.0
# 生产环境应只列出可信前端域名；同源部署可留空。
CORS_ORIGINS=

# ---------- AI 大模型（AI 成长助手 + 沟通实战陪练共用） ----------
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=20000

# ---------- 科大讯飞语音评测（口才跟读评分） ----------
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_TIMEOUT_MS=45000
MAX_AUDIO_BYTES=10485760

# ---------- 邮箱账号、验证与找回密码 ----------
# 生产环境必填：生成示例 node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# 必须挂载到 Sealos 持久化卷的路径。
AUTH_DATA_FILE=/app/data/users.json
AUTH_COOKIE_NAME=sg_session
AUTH_SESSION_DAYS=14
# HTTPS 公网域名为 true；仅本地 HTTP 调试时设为 false。
AUTH_COOKIE_SECURE=true
PRIVACY_POLICY_VERSION=2026-08-20

# 个人 QQ 邮箱 SMTP：SMTP_PASS 是 QQ 邮箱授权码，不是 QQ 登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=拾光成长 <your-qq-email@qq.com>
# 验证和重置链接的公网 HTTPS 地址。
APP_BASE_URL=http://127.0.0.1:8787
EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
