# ============ 拾光成长 · 服务端环境变量模板 ============
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 切勿把 .env 提交到 Git（已加入 .gitignore，只提交本模板）

# ---------- 服务 ----------
# 监听端口（默认 8787）
PORT=8787
# 监听地址（默认 0.0.0.0，本地调试可保持默认）
# HOST=0.0.0.0

# ---------- AI 大模型（AI 成长助手 + 沟通实战陪练共用） ----------
# 必填：不填则 /api/ai/chat 与 /api/ai/coach 返回 503
# 支持任意 OpenAI 兼容接口，换供应商只改 baseUrl + model
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
# 可选：采样温度（默认 0.7）
# AI_TEMPERATURE=0.7
# 可选：单次请求超时毫秒（默认 20000）
# AI_TIMEOUT_MS=20000

# ---------- 科大讯飞语音评测（口才跟读评分） ----------
# 必填：不填则 /api/ai/speech-score 返回 503
# 到讯飞开放平台开通「语音评测」服务后获取
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
# 可选：评测超时毫秒（默认 45000）
# IFLYTEK_TIMEOUT_MS=45000

# ---------- 其他可选 ----------
# 录音文件大小上限（字节，默认 10MB）
# MAX_AUDIO_BYTES=10485760
# 跨域白名单（逗号分隔；留空表示允许任意来源，生产建议配置具体域名）
# CORS_ORIGINS=https://your-domain.com
