# AI provider settings (server-side only)
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=20000
PORT=8787
HOST=0.0.0.0
# Comma-separated browser origins. Required only when the frontend uses a different domain.
CORS_ORIGINS=

# iFlytek ISE speech evaluation (server-side only)
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_TIMEOUT_MS=45000
MAX_AUDIO_BYTES=10485760

# Email accounts
# REQUIRED in production. Generate a long random value, e.g. openssl rand -base64 48.
AUTH_SECRET=
# Persist this path on a Sealos volume.
AUTH_DATA_FILE=/app/data/users.json
AUTH_COOKIE_NAME=sg_session
AUTH_SESSION_DAYS=14
# true for deployed HTTPS domains; false only when developing at http://127.0.0.1.
AUTH_COOKIE_SECURE=true
PRIVACY_POLICY_VERSION=2026-08-20

# Outbound email: personal QQ mailbox example. SMTP_PASS is the QQ Mail authorization code, not the QQ password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=拾光成长 <your-qq-email@qq.com>
# Public HTTPS URL used inside verification and password-reset links.
APP_BASE_URL=http://127.0.0.1:8787
EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
